<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
	REGRESSION: every functional test case on one browser.
	Runs test classes in parallel (4 browsers at a time).

	mvn test -Dsuite=testng-regression.xml
	mvn test -Dsuite=testng-regression.xml -Dbrowser=edge -Dheadless=true
-->
<suite name="TestKart Regression" parallel="classes" thread-count="4">

	<test name="Regression Tests">
		<groups>
			<run>
				<include name="regression" />
			</run>
		</groups>
		<classes>
			<class name="tests.LoginTest" />
			<class name="tests.SessionTest" />
			<class name="tests.SignupTest" />
			<class name="tests.ProductCatalogueTest" />
			<class name="tests.CartTest" />
			<class name="tests.CouponTest" />
			<class name="tests.CheckoutTest" />
			<class name="tests.EndToEndTest" />
		</classes>
	</test>

</suite>
